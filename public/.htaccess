<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve existing files/folders as-is (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else -> index.html (let React Router handle it)
  RewriteRule ^ index.html [L]
</IfModule>
